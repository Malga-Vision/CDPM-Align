{
    "environment": {
        "gpu": 0,
        "seed": 42,
        "output_dir": "/nethome/home/user/Experiments/miccai26/pretraining/ssl"
    },
    "model": {
        "architecture": "dino",
        "encoder": "resnet101",
        "encoder_weights": null,
        "use_smp_encoder": true,
        "ssl_params": {
            "dino":     { "projection_dim": 256, "hidden_dim": 2048, "bottleneck_dim": 256,
                          "temp_s": 0.1, "temp_t": 0.5, "m": 0.5, "lamda": 0.996, "num_crops": 6 },
            "simclrv2": { "projection_dim": 128, "temperature": 0.5 },
