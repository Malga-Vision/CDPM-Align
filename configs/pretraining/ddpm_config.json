{
    "environment": {
        "gpu": 0,
        "seed": 42,
        "output_dir": "outputs/pretraining/ddpm"
    },
    "model": {
        "use_ema": true,
        "unet": {
            "channel_mults": [1, 2, 4, 8],
            "attn_res": 32,
            "num_head_channels": 4,
            "res_blocks": 4,
            "self_condition": true
        },
        "beta_schedule": {
            "train": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-4,
                "linear_end": 0.02
            },
            "test": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-4,
                "linear_end": 0.02
            }
        },
        "model_for_inference": "last_ema_model.pt",
        "pretrained_path": null
    },
    "training": {
        "learning_rate": 1e-4,
        "optimizer": "adamw",
        "scheduler": null,
        "loss_function": "l2",
        "iterations": 50000,
        "freq_metrics": 5000,
        "freq_checkpoint": 5000,
        "resume": false
    },

    "task_type": "pretraining",
    "dataset": {
        "name": "chest",
        "path": "data/",
        "image_size": [256, 256],
        "image_channels": 1
    },
    "dataloader": {
        "batch_size": 1,
        "grad_accumulation": 8,
        "num_workers": 16,
        "pin_memory": true
    },
    "mode": "train"
}
